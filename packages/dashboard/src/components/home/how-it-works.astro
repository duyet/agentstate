---
/**
 * How AgentState works — fleet hub + request lifecycle visualization.
 */
import HubDiagram from "./hub-diagram.astro";

interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;

const lifecycle = [
  {
    n: "01",
    title: "Agent calls",
    body: "REST, TypeScript/Python SDK, or MCP — same auth, same project.",
  },
  {
    n: "02",
    title: "Edge API",
    body: "Cloudflare Worker validates the key, scopes, and rate limits.",
  },
  {
    n: "03",
    title: "Five primitives",
    body: "State, leases, claims, tokens, and conversations behind one API.",
  },
  {
    n: "04",
    title: "Durable store",
    body: "D1 at the edge — versioned events, search indexes, audit trails.",
  },
  {
    n: "05",
    title: "Observe",
    body: "Dashboard analytics, webhooks, bulk export, and SSE state watch.",
  },
] as const;
---
<div class={cls}>
  <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <HubDiagram class="mx-auto max-w-md lg:max-w-none" />
      <p class="mt-4 text-center font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
        Agents coordinate through one hub
      </p>
    </div>

    <div>
      <ol class="relative space-y-0">
        {lifecycle.map((step, i) => (
          <li class="relative flex gap-4 pb-8 last:pb-0">
            {i < lifecycle.length - 1 && (
              <span
                class="absolute left-[15px] top-8 h-[calc(100%-0.5rem)] w-px bg-border"
                aria-hidden="true"
              />
            )}
            <span class="relative z-[1] grid size-8 shrink-0 place-items-center rounded-full border border-border bg-card font-mono text-[11px] text-accent">
              {step.n}
            </span>
            <div class="pt-0.5">
              <div class="text-[15px] font-medium text-foreground">{step.title}</div>
              <p class="mt-1 text-[13.5px] leading-relaxed text-muted-foreground">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- Flow strip: agents → primitives → outcomes -->
  <div class="mt-16 overflow-x-auto">
    <div class="mx-auto flex min-w-[640px] items-stretch justify-center gap-2 sm:gap-3">
      <div class="flex flex-1 flex-col items-center rounded-xl border border-border bg-card p-4 text-center">
        <span class="as-label text-[10px] text-muted-foreground">clients</span>
        <span class="mt-2 text-[13px] font-medium text-foreground">Agents · apps · IDEs</span>
        <span class="mt-1 font-mono text-[11px] text-muted-foreground">SDK · REST · MCP</span>
      </div>
      <div class="flex items-center text-muted-foreground" aria-hidden="true">
        <svg width="24" height="12" viewBox="0 0 24 12" fill="none" class="as-dash-arrow">
          <path d="M0 6h20M16 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="flex flex-[1.2] flex-col items-center rounded-xl border border-accent/40 bg-accent/10 p-4 text-center">
        <span class="as-label text-[10px] text-accent">hub</span>
        <span class="mt-2 text-[13px] font-medium text-foreground">AgentState</span>
        <span class="mt-1 font-mono text-[11px] text-muted-foreground">Worker + D1</span>
      </div>
      <div class="flex items-center text-muted-foreground" aria-hidden="true">
        <svg width="24" height="12" viewBox="0 0 24 12" fill="none">
          <path d="M0 6h20M16 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="flex flex-1 flex-col items-center rounded-xl border border-border bg-card p-4 text-center">
        <span class="as-label text-[10px] text-muted-foreground">outcomes</span>
        <span class="mt-2 text-[13px] font-medium text-foreground">Memory · locks · audit</span>
        <span class="mt-1 font-mono text-[11px] text-muted-foreground">search · webhooks</span>
      </div>
    </div>
  </div>
</div>
