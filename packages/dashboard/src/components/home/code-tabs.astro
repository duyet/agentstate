---
import { highlightCode, resolveLang } from "../../lib/highlight";

interface Tab {
  label: string;
  lang: string;
  code: string;
}
interface Props {
  tabs: Tab[];
  class?: string;
  /** Show copy button on each panel (default true). */
  copyable?: boolean;
}
const { tabs, class: cls = "", copyable = true } = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
const highlighted = await Promise.all(
  tabs.map(async (t) => ({
    ...t,
    html: await highlightCode(t.code, t.lang),
    shikiLang: resolveLang(t.lang),
  })),
);
---
<div class={`codetabs overflow-hidden rounded-xl border border-border bg-card ${cls}`} data-codetabs={uid}>
  <div class="ct-bar flex items-center gap-1 overflow-x-auto border-b border-border bg-muted px-2 py-1.5">
    {highlighted.map((t, i) => (
      <label for={`ct-${uid}-${i}`} class="ct-tab shrink-0 cursor-pointer select-none rounded-[var(--radius-sm)] px-3 py-1 font-mono text-[11.5px] transition-colors">{t.label}</label>
    ))}
    <span class="ct-lang ml-auto shrink-0 font-mono text-[11px] text-muted-foreground" data-ct-lang>{highlighted[0]?.shikiLang}</span>
    {copyable && (
      <button
        type="button"
        class="ct-copy ml-1 inline-flex shrink-0 items-center gap-1 rounded-[var(--radius-sm)] px-2 py-1 font-mono text-[11px] text-muted-foreground transition-colors hover:bg-panel hover:text-foreground"
        data-ct-copy
        aria-label="Copy code"
      >
        <span data-ct-copy-label>copy</span>
      </button>
    )}
  </div>
  {highlighted.map((t, i) => (
    <>
      <input
        class="ct-input"
        type="radio"
        name={`ct-${uid}`}
        id={`ct-${uid}-${i}`}
        checked={i === 0}
        data-lang={t.shikiLang}
        data-panel={`ct-src-${uid}-${i}`}
      />
      <div class="ct-panel">
        <script type="text/plain" id={`ct-src-${uid}-${i}`} set:html={t.code} />
        <div class="as-shiki overflow-auto bg-[#0c0c0e] p-4" set:html={t.html} />
      </div>
    </>
  ))}
</div>

<script>
  function initCodeTabs(root: Element) {
    const langEl = root.querySelector("[data-ct-lang]");
    const copyBtn = root.querySelector("[data-ct-copy]") as HTMLButtonElement | null;
    const copyLabel = root.querySelector("[data-ct-copy-label]");
    const inputs = root.querySelectorAll<HTMLInputElement>(".ct-input");

    const active = () => root.querySelector<HTMLInputElement>(".ct-input:checked");

    const syncLang = () => {
      const el = active();
      if (langEl && el?.dataset.lang) langEl.textContent = el.dataset.lang;
    };

    inputs.forEach((input) => {
      input.addEventListener("change", syncLang);
    });

    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const el = active();
        const srcId = el?.dataset.panel;
        const src = srcId ? document.getElementById(srcId) : null;
        const code = src?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(code);
          if (copyLabel) copyLabel.textContent = "copied";
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = "copy";
          }, 1200);
        } catch {
          if (copyLabel) copyLabel.textContent = "copy";
        }
      });
    }
  }

  document.querySelectorAll("[data-codetabs]").forEach(initCodeTabs);
</script>

<style>
  .codetabs .ct-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .codetabs .ct-tab {
    color: var(--color-fg-4);
  }
  .codetabs .ct-tab:hover {
    color: var(--color-fg-2);
  }
  .codetabs .ct-panel {
    display: none;
  }
  .codetabs .ct-input:checked + .ct-panel {
    display: block;
  }
  /* Active tab — support up to 8 tabs */
  .codetabs:has(.ct-input:nth-of-type(1):checked) .ct-bar .ct-tab:nth-of-type(1),
  .codetabs:has(.ct-input:nth-of-type(2):checked) .ct-bar .ct-tab:nth-of-type(2),
  .codetabs:has(.ct-input:nth-of-type(3):checked) .ct-bar .ct-tab:nth-of-type(3),
  .codetabs:has(.ct-input:nth-of-type(4):checked) .ct-bar .ct-tab:nth-of-type(4),
  .codetabs:has(.ct-input:nth-of-type(5):checked) .ct-bar .ct-tab:nth-of-type(5),
  .codetabs:has(.ct-input:nth-of-type(6):checked) .ct-bar .ct-tab:nth-of-type(6),
  .codetabs:has(.ct-input:nth-of-type(7):checked) .ct-bar .ct-tab:nth-of-type(7),
  .codetabs:has(.ct-input:nth-of-type(8):checked) .ct-bar .ct-tab:nth-of-type(8) {
    background: var(--color-panel);
    color: var(--color-fg);
  }
  .as-shiki :global(pre) {
    background: transparent !important;
    margin: 0;
    padding: 0;
    overflow-x: auto;
  }
  .as-shiki :global(code) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
  }
</style>
