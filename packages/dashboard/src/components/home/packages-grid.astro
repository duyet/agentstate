---
import { MCP_URL } from "../../lib/site";

const packages = [
  {
    name: "@agentstate/sdk",
    ecosystem: "TypeScript · npm",
    body: "Typed client for all primitives, plus Vercel AI SDK and LangGraph adapters.",
    install: "npm i @agentstate/sdk",
    docs: "/docs/#quickstart",
    registry: "https://www.npmjs.com/package/@agentstate/sdk",
    registryLabel: "npm",
    extras: ["@agentstate/sdk/ai-sdk", "@agentstate/sdk/langgraph"],
  },
  {
    name: "agentstate",
    ecosystem: "Python · PyPI",
    body: "HTTPX client with LangGraph checkpointer extras for Python agent fleets.",
    install: "pip install agentstate",
    docs: "/docs/#quickstart",
    registry: "https://pypi.org/project/agentstate/",
    registryLabel: "PyPI",
    extras: ["pip install agentstate[langgraph]"],
  },
  {
    name: "@agentstate/mcp",
    ecosystem: "MCP · local stdio",
    body: "Run AgentState tools in Cursor, Claude Desktop, or Windsurf over stdio.",
    install: "npx @agentstate/mcp",
    docs: "/docs/#mcp",
    registry: "https://www.npmjs.com/package/@agentstate/mcp",
    registryLabel: "npm",
    extras: [] as string[],
  },
  {
    name: "Hosted MCP",
    ecosystem: "Remote · streamable HTTP",
    body: "Point any MCP client at the hosted endpoint — OAuth 2.1 or bearer key.",
    install: MCP_URL,
    docs: "/docs/#mcp",
    registry: "/openapi.json",
    registryLabel: "OpenAPI",
    extras: [] as string[],
  },
  {
    name: "REST API",
    ecosystem: "Any language",
    body: "Snake_case JSON, bearer auth, cursor pagination — small enough for agent context.",
    install: "curl https://agentstate.app/api/v1/...",
    docs: "/docs/",
    registry: "/openapi.json",
    registryLabel: "OpenAPI",
    extras: ["/llms.txt", "/agents.md"],
  },
] as const;
---
<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  {packages.map((pkg) => (
    <article class="flex flex-col rounded-none border border-border bg-background p-5">
      <div class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{pkg.ecosystem}</div>
      <h3 class="mt-2 font-mono text-[15px] font-medium text-foreground">{pkg.name}</h3>
      <p class="mt-2 flex-1 text-[13.5px] leading-relaxed text-muted-foreground">{pkg.body}</p>
      <div class="mt-4 overflow-x-auto rounded-none border border-border bg-background px-3 py-2">
        <code class="font-mono text-[12px] text-fg-2">{pkg.install}</code>
      </div>
      {pkg.extras.length > 0 && (
        <ul class="mt-2 space-y-0.5">
          {pkg.extras.map((x) => (
            <li class="font-mono text-[11px] text-muted-foreground">{x}</li>
          ))}
        </ul>
      )}
      <div class="mt-4 flex flex-wrap items-center gap-3 text-[13px]">
        <a href={pkg.docs} class="font-medium text-accent hover:opacity-80">Setup docs →</a>
        <a
          href={pkg.registry}
          class="text-muted-foreground hover:text-foreground"
          {...(pkg.registry.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {pkg.registryLabel}
        </a>
      </div>
    </article>
  ))}
</div>
